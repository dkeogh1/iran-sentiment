# --- X (Twitter) API credentials ---
# Apply at https://developer.x.com  (Basic tier ~$100/mo, or Pro for historical search)
X_BEARER_TOKEN=
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# --- Truth Social ---
# Username/password for truthbrush client (or leave blank to use public-only scraping)
TRUTH_SOCIAL_USERNAME=
TRUTH_SOCIAL_PASSWORD=
# truthbrush and ts-login read these spellings (no underscore); set both pairs
TRUTHSOCIAL_USERNAME=
TRUTHSOCIAL_PASSWORD=
# Written by `python -m src.cli ts-login`; needed for collect-replies
TRUTHSOCIAL_TOKEN=

# --- Optional: Anthropic API for LLM-based sentiment ---
ANTHROPIC_API_KEY=

# --- Off-box backup (`python -m src.cli backup`) ---
# Bucket from homelab-infra terraform/iran-sentiment-backups.tf (s3:// optional)
IRAN_BACKUP_S3_BUCKET=
# Access key of the bucket's append-only writer; read by the aws CLI
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
